{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 公開URLの先頭部分になる(https://<name>.<アカウントのサブドメイン>.workers.dev)。
  // 内部呼称(-v2-server)が利用者に見えるURLへ出ないよう、アプリ名そのものにしている(2026-08-10変更)。
  // この値を変えると別のWorkerとして作られるため、シークレットの再投入が必要になる。
  "name": "it-index",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "it-index-v2",
      // 2026-08-10にwrangler d1 createで作成した実D1のid(リージョンAPAC)。
      "database_id": "ece940d0-feaa-44dc-815f-d7e6cb8818c7",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 本番運用はOpenAIに一本化(2026-08-10)。ANTHROPIC_API_KEYへ戻す場合は
  // AI_PROVIDERを"anthropic"に変更しAI_MODELをAnthropic側のモデルIDに変更する。
  // vitest-pool-workersはこのwrangler.jsoncを読むが、vitest.config.tsのminiflare bindingsで
  // AI_PROVIDER/AI_MODELを明示的に上書きしているため既存(Anthropic経路)のテストは影響を受けない。
  // 回数上限はサーバー側キー(運営者負担)を使う場合にだけ効く。利用者が自分のキーを
  // 設定した場合は本人負担のため上限の対象外(src/index.ts)。運営者負担分を絞る値を明示する
  // (コード側の既定値50/500はそのまま残し、ここでの上書きで運用値を決める)。
  "vars": {
    "AI_PROVIDER": "openai",
    "AI_MODEL": "gpt-5.6-luna",
    "AI_DAILY_LIMIT_PER_USER": "10",
    "AI_DAILY_LIMIT_GLOBAL": "100"
  }
}
