# OS
.DS_Store
Thumbs.db

# エディタ
.vscode/
.idea/
*.swp

# 環境変数
.env
.env.*
!.env.example
# v2/client/.env.android: Capacitor Androidビルド専用。中身は公式ホストの公開URL(秘密情報なし)で
# コミット対象(PR-S)。除外すると`npm run build:android`がVITE_API_BASE未設定のまま動く。
!v2/client/.env.android
.dev.vars
.dev.vars.*
!.dev.vars.example

# Cloudflare Workers/wranglerのローカル実行状態(D1ローカルDB等)
.wrangler/

# ログ
*.log

# 依存・ビルド成果物
node_modules/
dist/
dist-ssr/
*.local

# Electronビルド成果物
dist-electron/
release/

# 検証ツールの実行成果物（ログ・レポート自体は docs/review 配下でコミット対象、生成物のみ除外）
test-results/
docs/review/logs/playwright-report/
docs/review/logs/lhci-report/
.lighthouseci/

# 検証用に一時ダウンロードしたバイナリ（コミット対象外）
.tools/
